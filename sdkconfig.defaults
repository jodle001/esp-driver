# Scorbot controller firmware defaults (idf.py reads these into a fresh sdkconfig).
CONFIG_IDF_TARGET="esp32"

# The link to the Pi owns UART0 (the DevKit's USB) and there is no console: the Eshed box has none,
# and UART1's pins carry the slide encoder on the rev 0.3 board (Oct 16 2026). For a bench build with
# ESP_LOG on the USB, set the console back to UART0 and SC_LINK_UART_NUM to 1 with pins of your own.
CONFIG_ESP_CONSOLE_NONE=y

# 1 ms tick: the current task paces ADC conversions with vTaskDelay(1).
CONFIG_FREERTOS_HZ=1000

# The 1 kHz control timer fires from the ISR dispatch path.
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y

# Pulse counter reads from the switch-edge interrupt must not touch flash cache.
CONFIG_PCNT_CTRL_FUNC_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

# nanopb: static messages only.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The second-stage bootloader shares UART0 with the Pi link; CONFIG_ESP_CONSOLE_NONE already nulls its
# output channels, this keeps it from formatting the lines at all (the ROM log is silenced by IO15 low, R36).
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
