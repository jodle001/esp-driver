menu "Talos ESP Driver Configuration"

    comment "Pins follow the rev 0.4 board, an ESP32-S3-DevKitC-1 (design doc section 8)"

    menu "Link to the Pi"
        choice SC_LINK_MODE
            prompt "Protocol on the link"
            default SC_LINK_MODE_ACL
            help
                Decided Oct 16 2026: the Pi runs the operator unchanged, so the link speaks
                the Eshed box's serial dialect (the ACL subset, scorbot_core/acl.h) at
                9600 8N1 over the DevKit's USB-UART bridge. The protobuf/COBS link of the
                ROS 2 stack remains as a second mode at 921600. "Auto" starts in the dialect
                at 9600 and switches to protobuf at 921600 when the first bytes are not text
                (a 0x00 frame delimiter, or framing errors from a 921600 stream read at 9600).
            config SC_LINK_MODE_ACL
                bool "Eshed dialect (ACL text, 9600): the operator"
            config SC_LINK_MODE_PROTOBUF
                bool "protobuf/COBS (921600): the ROS 2 hardware interface"
            config SC_LINK_MODE_AUTO
                bool "auto: decide from the first bytes (untested on a device)"
        endchoice
        config SC_LINK_UART_NUM
            int "Link UART number"
            range 0 2
            default 0
            help
                0 = the DevKitC-1's USB-UART bridge (the first USB-C socket, "UART"): the
                Pi link and the flashing port. The console is the S3's USB-Serial-JTAG
                peripheral on the second socket (sdkconfig.defaults), so no UART pin is
                spent on logging.
        config SC_LINK_TX_GPIO
            int "Link UART TX GPIO (-1 = the UART's default pin, 43 on the S3)"
            range -1 48
            default -1
        config SC_LINK_RX_GPIO
            int "Link UART RX GPIO (-1 = the UART's default pin, 44 on the S3)"
            range -1 48
            default -1
        config SC_LINK_ACL_BAUD
            int "Baud rate in the Eshed dialect"
            default 9600
            help
                What the operator opens the port at (reference_only/operator erv.cpp: B9600).
        config SC_LINK_PROTOBUF_BAUD
            int "Baud rate for protobuf"
            default 921600
        config SC_ACL_SIGN_MASK
            hex "Eshed dialect: axes whose virtual counts run against the calibrated positive (bit per joint)"
            default 0x0
            help
                The dialect reports and takes virtual ER-V counts (the operator's degree
                factors are the ER-V's). Bit i set flips the sign for joint i, so the Pi
                sees the same direction on this robot as on the ER-V. The scale comes from
                the ER-V factors in scorbot_core/acl.c; the robot's own counts per radian
                are the NVS calibration.
        config SC_WATCHDOG_MS
            int "Default command watchdog (ms)"
            default 200
    endmenu

    config SC_JOINT_COUNT
        int "Joints driven (5 = the arm, 6 = plus the rail, 7 = the arm, the gripper and the rail)"
        range 5 7
        default 7
        help
            Rev 0.4 carries seven identical channels in the Eshed's axis numbering: 1 to 5
            the arm, 6 the gripper (on the D50), 7 the rail (terminal J8). The last channel
            configured is always the rail: with 6, channel 6 is the rail and the gripper is
            not driven; with 7, channel 6 is the gripper. Leave a channel's driver module
            unfitted when its axis is not wired; its counter and sense lines still exist.

    menu "Motor PWM (LEDC)"
        config SC_PWM_FREQ_HZ
            int "PWM frequency (Hz)"
            default 20000
        config SC_PWM1_GPIO
            int "PWM 1 GPIO"
            default 15
        config SC_PWM2_GPIO
            int "PWM 2 GPIO"
            default 16
        config SC_PWM3_GPIO
            int "PWM 3 GPIO"
            default 17
        config SC_PWM4_GPIO
            int "PWM 4 GPIO"
            default 18
        config SC_PWM5_GPIO
            int "PWM 5 GPIO"
            default 39
        config SC_PWM6_GPIO
            int "PWM 6 GPIO (the gripper, or the rail when 6 joints are configured)"
            default 40
        config SC_PWM7_GPIO
            int "PWM 7 GPIO (the rail)"
            default 41
        config SC_SLP_GPIO
            int "Driver SLP (sleep) GPIO"
            default 42
            help
                The shared !SLP line of all drivers, held low through reset by the board's
                2.2 k pull-down, so no motor can move until the firmware says so.
        config SC_TOTAL_CURRENT_LIMIT_DA
            int "Summed motor current cap (0.1 A units, 0 = off)"
            default 80
            help
                While the sum of the measured motor currents is over this, an integral
                limiter winds every joint's velocity demand down together, and back up once
                the sum is under it again. It protects the 10 A fuse and the rail copper,
                which see the sum. Keep it above the largest single current_limit_a plus the
                running current of the other axes, or the homing hard-stop detector of a
                joint may never see its threshold.
    endmenu

    menu "Encoders (LS7366R counters on SPI)"
        config SC_SPI_SCLK_GPIO
            int "SPI SCLK GPIO"
            default 12
        config SC_SPI_MOSI_GPIO
            int "SPI MOSI GPIO"
            default 11
        config SC_SPI_MISO_GPIO
            int "SPI MISO GPIO"
            default 13
        config SC_SPI_HZ
            int "SPI clock (Hz)"
            default 10000000
        config SC_CNT1_CS_GPIO
            int "Counter 1 chip select"
            default 10
        config SC_CNT2_CS_GPIO
            int "Counter 2 chip select"
            default 9
        config SC_CNT3_CS_GPIO
            int "Counter 3 chip select"
            default 8
        config SC_CNT4_CS_GPIO
            int "Counter 4 chip select"
            default 7
        config SC_CNT5_CS_GPIO
            int "Counter 5 chip select"
            default 6
        config SC_CNT6_CS_GPIO
            int "Counter 6 chip select"
            default 5
        config SC_CNT7_CS_GPIO
            int "Counter 7 chip select"
            default 4
        config SC_CNT_CLK_GPIO
            int "Counter filter clock output GPIO (-1 = the board has an oscillator)"
            range -1 48
            default 14
        config SC_CNT_CLK_HZ
            int "Counter filter clock (Hz)"
            default 4000000
            help
                The LS7366R samples its A/B inputs with this clock; it must be well above
                the quadrature rate (the fastest encoder makes about 8 kHz of edges).
    endmenu

    menu "I2C: expanders and ADCs"
        config SC_I2C_SDA_GPIO
            int "SDA GPIO"
            default 1
        config SC_I2C_SCL_GPIO
            int "SCL GPIO"
            default 2
        config SC_I2C_SPEED_HZ
            int "I2C speed (Hz)"
            default 400000
            help
                The board is laid out for 1 MHz; start at 400 kHz and raise it once the bus
                is proven.
        config SC_EXPANDER_DIR_ADDRESS
            hex "MCP23017 DIR chip address (DIR1-7 out, ESTOP_SENSE in)"
            default 0x20
        config SC_EXPANDER_SENSE_ADDRESS
            hex "MCP23017 sense chip address (FLT1-7, SW1-7 in)"
            default 0x21
        config SC_EXPANDER_INT_GPIO
            int "Shared expander INT GPIO"
            default 47
        config SC_SWITCH_ACTIVE_LOW
            bool "Limit switch pressed reads low"
            default y
        config SC_ADC_A_ADDRESS
            hex "ADS1015 A address (CS1-4)"
            default 0x48
        config SC_ADC_B_ADDRESS
            hex "ADS1015 B address (CS5-7, VSENSE on A3)"
            default 0x49
        config SC_CS_MV_PER_A
            int "Driver current sense (mV per A)"
            default 20
        config SC_CS_OFFSET_MV
            int "Driver current sense offset at 0 A (mV)"
            default 50
        config SC_CS_MIN_DUTY_PCT
            int "Current sense: smallest duty used in the duty correction (%)"
            default 5
            help
                The G2's CS pin is active only while the H-bridge drives and is low during
                the PWM off-time, and the ADS1015 averages over its conversion, so the ADC
                reads duty x (20 mV/A x I + offset). The firmware divides by the commanded
                duty. Below this duty it divides by this value instead, so a small motor
                current is under-read rather than amplified from ADC noise.
        config SC_VSENSE_RATIO_X100
            int "Motor rail divider ratio x100 (39k/10k = 490)"
            default 490
        config SC_RAIL_OK_DV
            int "Motor rail present above (0.1 V units)"
            default 90
    endmenu

    config SC_PIXEL_GPIO
        int "Status pixel chain data GPIO (RMT; driver not written yet)"
        default 21

endmenu
